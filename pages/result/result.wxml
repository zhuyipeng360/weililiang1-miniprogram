<view class="container result"><text class="heading">{{exam}} · Part {{part}} 结果</text><text class="score">得分：{{score}} / {{maxScore}}</text><block wx:for="{{items}}" wx:key="index"><view class="result-row {{item.correct?'correct':'wrong'}}" data-index="{{index}}" bindtap="toggle"><text>{{item.displayNumber}}：{{item.pending?'待老师批改':(item.correct?'正确':'错误')}}</text><text wx:if="{{expanded[index]}}" class="explanation">{{item.explanationText}}</text></view></block><button bindtap="continueExam">继续答题</button><button bindtap="goHome">回到首页</button></view>