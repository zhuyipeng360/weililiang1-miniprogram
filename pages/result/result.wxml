<view class="container result"><text class="heading">{{exam}} · Part {{part}} 结果</text><text class="score">得分：{{score}} / {{maxScore}}</text><block wx:for="{{items}}" wx:key="question_id"><view class="result-row {{item.correct?'correct':'wrong'}}" data-index="{{index}}" bindtap="toggle"><text>第 {{item.question_number||index+1}} 题 {{item.pending?'待老师批改':(item.correct?'正确':'错误')}}</text><text wx:if="{{expanded[index]}}">{{item.explanation}}</text></view></block><button bindtap="continueExam">继续答题</button></view>
