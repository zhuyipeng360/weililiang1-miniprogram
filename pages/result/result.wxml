<view class="container result"><text class="heading">{{exam}} · Part {{part}} 结果</text><text class="score">得分：{{score}} / {{maxScore}}</text><text class="summary">正确率 {{accuracy}}% · 答对 {{correctCount}}/{{totalQuestions}} · 用时 {{durationSeconds}} 秒 · 待评分 {{pendingCount}} 题</text><block wx:for="{{items}}" wx:key="index"><view class="result-row {{item.correct?'correct':'wrong'}}" data-index="{{index}}" bindtap="toggle"><text>{{item.displayNumber}}：{{item.pending?'待老师批改':(item.correct?'正确':'错误')}}</text><view wx:if="{{expanded[index]}}" class="detail"><text>{{item.prompt}}</text><block wx:for="{{item.options}}" wx:for-item="option" wx:key="key"><text>{{option.key}}. {{option.text}}</text></block><text>你的答案：{{item.userAnswer}}</text><text>正确答案：{{item.correctAnswer}}</text><text class="explanation">{{item.explanationText}}</text></view><view wx:if="{{item.audioscript}}" class="audioscript"><text>听力原文：</text><text>{{item.audioscript}}</text></view></view></block><button bindtap="continueExam">继续答题</button><button bindtap="goHome">回到首页</button></view>