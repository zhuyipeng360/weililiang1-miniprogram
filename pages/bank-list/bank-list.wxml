<view class="container bank-list"><text class="eyebrow">{{level}}</text><view class="list-head"><button class="back-button" bindtap="goBack">‹ 返回</button><text class="heading">题库列表</text></view><text class="current-path">{{currentPath}}</text><text wx:if="{{loading}}">正在读取题库…</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="bank-grid"><block wx:for="{{banks}}" wx:key="name"><button class="bank-card" data-item="{{item}}" bindtap="openBank"><text>{{item.name}}</text><text class="meta">{{item.type === 'FOLDER' ? '目录' : '打开题目'}}</text></button></block></view></view>
