<view class="container bank-list"><text class="eyebrow">{{level}}</text><text class="heading">题库列表</text><text wx:if="{{loading}}">正在读取题库…</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="bank-grid"><block wx:for="{{banks}}" wx:key="path"><button class="bank-card" data-path="{{item.path}}" bindtap="openBank"><text>{{item.name}}</text><text class="meta">{{item.type === 'FOLDER' ? '含多个 Part' : '题库文件'}}</text></button></block></view></view>
