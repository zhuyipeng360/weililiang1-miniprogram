.bank-list { padding:48rpx 0 80rpx; }.eyebrow { color:#8a6a4a; }.heading { display:block; font-size:48rpx; font-weight:700; margin:16rpx 0 36rpx; }.error { display:block; color:#b42318; margin:20rpx 0; }.bank-grid { display:grid; grid-template-columns:1fr; gap:20rpx; }.bank-card { margin:0; padding:28rpx; text-align:left; background:#fff; border-radius:16rpx; font-size:30rpx; }.meta { display:block; margin-top:10rpx; color:#888; font-size:24rpx; }@media (min-width:600px) { .bank-grid { grid-template-columns:repeat(2,1fr); } }
