<view class="container home {{screenLevel}}">
  <view class="topbar"><view><text class="eyebrow">WEILILIANG1.COM</text><text class="title">剑桥英语题库</text></view><button class="login-button" wx:if="{{!user}}" bindtap="handleLogin">登录</button><view wx:else class="profile"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"><image src="{{user.avatarUrl || user.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"/></button><view class="profile-copy"><text>{{user.nickName || user.nickname || '微信用户'}}</text><input wx:if="{{!user.nickName || user.nickName === '微信用户'}}" class="nickname-input" type="nickname" placeholder="请输入昵称" bindblur="onNicknameBlur" value="{{user.nickName}}" /></view><button wx:if="{{!user.nickName || user.nickName === '微信用户'}}" bindtap="getProfile">获取头像昵称</button><button bindtap="logout">退出</button></view></view>
  <view wx:if="{{!user}}" class="notice">题目可以公开浏览，开始作答时登录即可。</view>
  <view class="hero"><text class="eyebrow">CAMBRIDGE ENGLISH</text><text class="heading">选择考试，开始练习</text><text class="subheading">按需加载题库，不把题目打包进小程序。</text></view>
  <view class="exam-grid"><block wx:for="{{['KET','PET','FCE','CAE']}}" wx:key="*this"><button class="exam-card" data-exam="{{item}}" bindtap="chooseExam"><text>{{item}}</text><text class="arrow">→</text></button></block></view>
  <text class="status">{{loginMessage}}</text>
</view>
