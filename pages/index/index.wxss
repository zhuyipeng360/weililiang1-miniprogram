.home { padding: 32rpx 0 80rpx; min-height: 100vh; box-sizing: border-box; }.topbar,.profile { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.eyebrow { display:block; color:#8a6a4a; letter-spacing:2rpx; font-size:22rpx; }.title { display:block; font-size:38rpx; font-weight:700; margin-top:8rpx; }.login-button,.profile button { margin:0; font-size:28rpx; color:#7b4f2d; background:transparent; }.profile image { width:64rpx;height:64rpx;border-radius:50%; }.profile text { max-width:180rpx; overflow:hidden; }.profile button { padding:0; }.notice { margin-top:36rpx; padding:24rpx; background:#fff7df; border-radius:16rpx; }.hero { padding:100rpx 0 48rpx; }.heading { display:block; font-size:52rpx; font-weight:700; margin:18rpx 0; }.subheading { color:#667085; }.exam-grid { display:grid; grid-template-columns:1fr; gap:24rpx; }.exam-card { margin:0; min-height:180rpx; display:flex; align-items:center; justify-content:space-between; padding:36rpx; border-radius:22rpx; background:#fff; color:#1f2933; font-size:42rpx; font-weight:700; box-shadow:0 8rpx 24rpx #3b2b1d12; }.arrow { color:#b8753c; }.status { display:block; min-height:40rpx; margin-top:24rpx; color:#8a6a4a; }@media (min-width:600px) { .exam-grid { grid-template-columns:repeat(2,1fr); gap:32rpx; }.exam-card { min-height:220rpx; font-size:48rpx; }.hero { padding-top:120rpx; } }@media (min-width:1000px) { .home { padding-top:48rpx; } }
.debug-panel { margin-top:24rpx; padding:16rpx; color:#8b8b8b; background:#f0eee9; border-radius:10rpx; font-size:20rpx; }.debug-title,.debug-line { display:block; }.debug-title { font-weight:600; margin-bottom:6rpx; }.debug-line { word-break:break-all; line-height:1.5; }
