<view class="container wrong-book"><text class="heading">错题本</text><view wx:if="{{!items.length}}">暂无错题</view><block wx:for="{{items}}" wx:key="questionId"><view class="wrong-item"><text>{{item.exam}} · Part {{item.part}}</text><text>{{item.prompt}}</text><button data-index="{{index}}" bindtap="practice">重新练习</button><button data-id="{{item.questionId}}" bindtap="remove">移出错题本</button></view></block></view>
