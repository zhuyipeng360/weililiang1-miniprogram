<view class="container history"><text class="heading">答题历史</text><text wx:if="{{loading}}">正在加载…</text><text wx:if="{{error}}" class="error">{{error}}</text><view wx:if="{{!loading&&!items.length&&!error}}">暂无答题记录</view><block wx:for="{{items}}" wx:key="id"><button class="history-item" data-index="{{index}}" bindtap="open"><text>{{item.title||item.exam_code||'考试'}} · Test {{item.test||'-'}} · Part {{item.part||'-'}}</text><text>得分：{{item.result.score||0}}/{{item.result.max_score||0}}　{{item.submitted_at||item.started_at||''}}</text></button></block></view>
