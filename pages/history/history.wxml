<view class="container history"><text class="heading">答题历史</text><view class="history-filters"><block wx:for="{{['','KET','PET','FCE','CAE']}}" wx:key="*this"><button class="filter {{item===examCode?'active':''}}" data-exam="{{item}}" bindtap="filter">{{item||'全部'}}</button></block><button wx:if="{{page<pages&&!loading}}" bindtap="loadMore">加载更多</button></view><text wx:if="{{loading}}">正在加载…</text><text wx:if="{{error}}" class="error">{{error}}</text><view wx:if="{{!loading&&!items.length&&!error}}">暂无答题记录</view><block wx:for="{{items}}" wx:key="id"><button class="history-item" data-index="{{index}}" data-attempt-id="{{item.id||item.attempt_id}}" bindtap="open"><text>{{item.bankName||item.bank_name||item.title||item.examCode||item.exam_code||'考试'}} · Test {{item.testNumber||item.test||'-'}} · Part {{item.partNumber||item.part||'-'}}</text><text>得分：{{item.scorePercent != null ? item.scorePercent + '%' : ((item.result&&item.result.score)||0)}}/{{item.totalQuestions||((item.result&&item.result.max_score)||0)}}　{{item.createdAt||item.submitted_at||item.started_at||''}}</text></button></block><button wx:if="{{page<pages&&!loading}}" bindtap="loadMore">加载更多</button></view>
