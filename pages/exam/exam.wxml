<view class="container exam"><text class="heading">答题</text><text wx:if="{{requestPath}}" class="path-debug">path：{{requestPath}}</text><text wx:if="{{loading}}">正在读取题目…</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="debug-panel" wx:if="{{debugLogs.length}}" bindtap="toggleDebug"><text class="debug-summary">调试：{{debugLogs[0]}} / {{debugLogs[1]}} {{debugOpen ? '▲' : '▼'}}</text><block wx:if="{{debugOpen}}"><block wx:for="{{debugLogs}}" wx:key="index"><text class="debug-line">{{item}}</text></block></block></view><view wx:if="{{parts.length}}" class="parts"><block wx:for="{{parts}}" wx:key="part"><view class="part"><text class="part-title">Part {{item.part}}</text><scroll-view wx:if="{{item.material}}" scroll-y="true" class="material"><text>{{item.material}}</text></scroll-view><block wx:for="{{item.questions}}" wx:key="id"><view class="question"><text class="progress">第 {{item.question_number}} 题</text><image wx:if="{{item.stimulusUrl}}" class="stimulus" src="{{item.stimulusUrl}}" mode="widthFix" binderror="onStimulusError"/><button wx:if="{{item.audioUrl}}" class="audio-button" data-url="{{item.audioUrl}}" bindtap="playAudio">▶ 播放听力</button><text class="prompt">{{item.prompt}}</text><textarea wx:if="{{item.display.interaction_type === 'writing'}}" class="writing-input" data-question="{{item.id}}" bindinput="onAnswerInput" placeholder="请输入答案" value="{{answers[item.id]}}"/><input wx:if="{{item.display.interaction_type === 'short_text' || item.display.interaction_type === 'transformation'}}" class="text-input" data-question="{{item.id}}" bindinput="onAnswerInput" placeholder="请输入答案" value="{{answers[item.id]}}"/><block wx:if="{{item.display.interaction_type === 'choice'}}"><block wx:for="{{item.options}}" wx:for-item="option" wx:key="key"><button class="option {{answers[item.id] === option.key ? 'selected' : ''}}" data-key="{{option.key}}" data-question="{{item.id}}" bindtap="choose">{{option.key}}. {{option.text}}</button></block></block></view></block></view></block></view></view>
