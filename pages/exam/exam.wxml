<view class="container exam"><text class="heading">答题</text><text wx:if="{{requestPath}}" class="path-debug">path：{{requestPath}}</text><text wx:if="{{loading}}">正在读取题目…</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="debug-panel" wx:if="{{debugLogs.length}}"><block wx:for="{{debugLogs}}" wx:key="index"><text class="debug-line">{{item}}</text></block></view><view wx:if="{{questions.length}}" class="exam-layout"><view class="nav"><block wx:for="{{questions}}" wx:key="index"><button class="num {{current === index ? 'active' : ''}} {{answers[item.id || index] ? 'done' : ''}}" data-index="{{index}}" bindtap="selectQuestion">{{index + 1}}</button></block></view><view class="question"><text class="progress">第 {{current + 1}} / {{questions.length}} 题</text><text class="prompt">{{questions[current].prompt || questions[current].question}}</text><block wx:for="{{questions[current].options}}" wx:key="key"><button class="option {{answers[questions[current].id || current] === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="choose">{{item.key}}. {{item.text || item.label}}</button></block></view></view></view>
