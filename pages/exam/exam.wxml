<view class="container exam"><text class="heading">答题</text><text wx:if="{{requestPath}}" class="path-debug">path：{{requestPath}}</text><text wx:if="{{loading}}">正在读取题目…</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="debug-panel" wx:if="{{debugLogs.length}}" bindtap="toggleDebug"><text class="debug-summary">调试：{{debugLogs[0]}} / {{debugLogs[1]}} {{debugOpen ? '▲' : '▼'}}</text><block wx:if="{{debugOpen}}"><block wx:for="{{debugLogs}}" wx:key="index"><text class="debug-line">{{item}}</text></block></block></view><view wx:if="{{parts.length}}" class="parts"><block wx:for="{{parts}}" wx:key="part"><view class="part"><text class="part-title">Part {{item.part}}</text><scroll-view wx:if="{{item.material}}" scroll-y="true" class="material"><text>{{item.material}}</text></scroll-view><block wx:for="{{item.questions}}" wx:key="id"><view class="question"><text class="progress">第 {{item.question_number}} 题</text><text class="prompt">{{item.prompt}}</text><block wx:for="{{item.options}}" wx:key="key"><button class="option">{{item.key}}. {{item.text}}</button></block></view></block></view></block></view></view>
