<view class="container exam"><view class="exam-top"><text class="heading">答题</text><text class="timer">{{timerLabel}}</text></view><text wx:if="{{loading}}">正在读取题目…</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="debug-panel" wx:if="{{debugLogs.length}}" bindtap="toggleDebug"><text>调试：{{debugLogs[0]}} / {{debugLogs[1]}} {{debugOpen?'▲':'▼'}}</text></view><view wx:if="{{parts.length}}" class="part-tabs"><block wx:for="{{parts}}" wx:key="part"><button class="part-tab {{index===activePart?'active':''}}" data-index="{{index}}" bindtap="changePart">Part {{item.part}}</button></block></view><view wx:if="{{parts.length}}" class="part"><text class="part-title">Part {{parts[activePart].part}}</text><scroll-view wx:if="{{parts[activePart].material}}" scroll-y="true" class="material"><text>{{parts[activePart].material}}</text></scroll-view><block wx:for="{{parts[activePart].questions}}" wx:key="id"><view class="question"><text class="progress">第 {{item.question_number}} 题</text><image wx:if="{{item.stimulusUrl}}" class="stimulus" src="{{item.stimulusUrl}}" mode="widthFix"/><text class="prompt">{{item.prompt}}</text><textarea wx:if="{{item.display.interaction_type==='writing'}}" data-question="{{item.id}}" bindinput="onAnswerInput" value="{{answers[item.id]}}" placeholder="请输入答案"/><input wx:if="{{item.display.interaction_type==='short_text'||item.display.interaction_type==='transformation'}}" data-question="{{item.id}}" bindinput="onAnswerInput" value="{{answers[item.id]}}" placeholder="请输入答案"/><block wx:if="{{item.display.interaction_type==='choice'}}"><block wx:for="{{item.options}}" wx:for-item="option" wx:key="key"><button class="option {{answers[item.id]===option.key?'selected':''}}" data-key="{{option.key}}" data-question="{{item.id}}" bindtap="choose">{{option.key}}. {{option.text}}</button></block></block></view></block><button bindtap="submitPart">提交本部分</button></view></view>
