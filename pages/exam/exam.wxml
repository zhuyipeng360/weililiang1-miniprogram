<view class="container exam"><view class="exam-top"><text class="heading">答题</text><text class="timer">{{timerLabel}}</text></view><text wx:if="{{loading}}">正在读取题目…</text><text wx:if="{{error}}" class="error">{{error}}</text><view wx:if="{{parts.length && !started}}" class="part-picker"><text class="part-title">请选择 Test / Part</text><block wx:for="{{parts}}" wx:key="index"><button class="part-card" data-index="{{index}}" data-test="{{item.test}}" data-part="{{item.part}}" bindtap="openPart">Test {{item.test}} · Part {{item.part}}</button></block></view><view wx:if="{{parts.length && started}}" class="part-tabs"><block wx:for="{{parts}}" wx:key="index"><button class="part-tab {{index===activePart?'active':''}}" data-index="{{index}}" bindtap="changePart">Part {{item.part}}</button></block></view><view wx:if="{{parts.length && started}}" class="part"><text class="part-title">Test {{parts[activePart].test}} · Part {{parts[activePart].part}}</text><scroll-view wx:if="{{parts[activePart].material}}" scroll-y="true" class="material"><text>{{parts[activePart].material}}</text></scroll-view><block wx:for="{{parts[activePart].questions}}" wx:key="id"><view class="question"><text class="progress">第 {{item.question_number}} 题</text><image wx:if="{{item.stimulusUrl}}" class="stimulus" src="{{item.stimulusUrl}}" mode="widthFix"/><view wx:if="{{item.audioUrl}}" class="audio-controls"><button data-url="{{item.audioUrl}}" bindtap="playAudio">{{audioPlaying?'暂停':'播放'}}</button><text>{{audioDuration?Math.floor(audioProgress):0}} / {{audioDuration?Math.floor(audioDuration):0}} 秒</text><block wx:for="{{[0.75,1,1.25,1.5,2]}}" wx:key="*this"><button data-rate="{{item}}" bindtap="setAudioRate">{{item}}×</button></block></view><text class="prompt">{{item.prompt}}</text><textarea wx:if="{{item.display.interaction_type==='writing'}}" data-question="{{item.id}}" bindinput="onAnswerInput" value="{{answers[item.id]}}" placeholder="请输入答案"/><block wx:if="{{item.gaps && item.gaps.length}}"><block wx:for="{{item.gaps}}" wx:key="*this"><input class="text-input" data-question="{{item.id}}" data-gap="{{item}}" bindinput="onGapInput" value="{{answers[item.id+'_\_gap'+item]}}" placeholder="第 {{item}} 空"/></block></block><input wx:if="{{item.display.interaction_type==='short_text'||item.display.interaction_type==='transformation'}}" data-question="{{item.id}}" bindinput="onAnswerInput" value="{{answers[item.id]}}" placeholder="请输入答案"/><block wx:if="{{item.display.interaction_type==='choice'}}"><block wx:for="{{item.options}}" wx:for-item="option" wx:key="key"><button class="option {{answers[item.id]===option.key?'selected':''}}" data-key="{{option.key}}" data-question="{{item.id}}" bindtap="choose">{{option.key}}. {{option.text}}</button></block></block></view></block><button bindtap="submitPart">提交整次练习</button></view></view>
