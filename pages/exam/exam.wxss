.exam { padding:40rpx 0 80rpx; }.heading { font-size:48rpx; font-weight:700; }.error { color:#b42318; }.exam-layout { display:flex; flex-direction:column; gap:24rpx; }.nav { display:flex; flex-wrap:wrap; gap:12rpx; }.num { margin:0; min-width:72rpx; height:72rpx; padding:0; font-size:26rpx; background:#eee; }.num.active { background:#8a6a4a; color:#fff; }.num.done { border:4rpx solid #5b8c5a; }.prompt { display:block; font-size:32rpx; line-height:1.6; margin:24rpx 0; }.progress { color:#888; }.option { min-height:88rpx; margin:16rpx 0; padding:20rpx; text-align:left; background:#fff; font-size:30rpx; border-radius:12rpx; }.option.selected { background:#f0dfc8; }@media (min-width:600px) { .exam-layout { flex-direction:row; align-items:flex-start; }.nav { width:220rpx; flex-shrink:0; position:sticky; top:20rpx; }.question { flex:1; } }@media (min-width:1000px) { .exam { width:900px; } }
.path-debug { display:block; color:#999; font-size:20rpx; word-break:break-all; margin:12rpx 0; }
.debug-panel { margin:16rpx 0; padding:12rpx; color:#888; background:#f1efeb; font-size:18rpx; }.debug-line { display:block; word-break:break-all; line-height:1.4; }
@media (max-width:599px) { .exam-layout { gap:12rpx; }.nav { display:flex; flex-wrap:nowrap; gap:10rpx; overflow-x:auto; white-space:nowrap; padding:4rpx 4rpx 12rpx; }.num { flex:0 0 52rpx; min-width:52rpx; width:52rpx; height:52rpx; border-radius:50%; font-size:22rpx; }.num.done { border-width:3rpx; }.question { width:100%; }.prompt { margin:16rpx 0 24rpx; font-size:32rpx; } }
.parts { margin-top:20rpx; }.part-title { display:block; font-size:34rpx; font-weight:700; margin:28rpx 0 16rpx; }.material { max-height:520rpx; padding:24rpx; box-sizing:border-box; background:#fffdf8; border:1rpx solid #e7dfd2; border-radius:12rpx; white-space:pre-wrap; line-height:1.6; }.part .question { margin-top:28rpx; }
.stimulus { display:block; width:100%; max-height:640rpx; margin:16rpx 0; border-radius:10rpx; }
