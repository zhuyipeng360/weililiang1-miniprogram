.exam { padding:40rpx 0 80rpx; }.heading { font-size:48rpx; font-weight:700; }.error { color:#b42318; }.exam-layout { display:flex; flex-direction:column; gap:24rpx; }.nav { display:flex; flex-wrap:wrap; gap:12rpx; }.num { margin:0; min-width:72rpx; height:72rpx; padding:0; font-size:26rpx; background:#eee; }.num.active { background:#8a6a4a; color:#fff; }.num.done { border:4rpx solid #5b8c5a; }.prompt { display:block; font-size:32rpx; line-height:1.6; margin:24rpx 0; }.progress { color:#888; }.option { min-height:88rpx; margin:16rpx 0; padding:20rpx; text-align:left; background:#fff; font-size:30rpx; border-radius:12rpx; }.option.selected { background:#f0dfc8; }@media (min-width:600px) { .exam-layout { flex-direction:row; align-items:flex-start; }.nav { width:220rpx; flex-shrink:0; position:sticky; top:20rpx; }.question { flex:1; } }@media (min-width:1000px) { .exam { width:900px; } }
